+    // New Architecture (interop) fallback: the real view is not reachable via
+    // the legacy view registry, so search the app's window hierarchy. There is
+    // only one publisher view mounted at a time, so this resolves to it.
+    private func findInWindows() -> RNLiveStreamViewImpl? {
+        for scene in UIApplication.shared.connectedScenes {
+            guard let ws = scene as? UIWindowScene else { continue }
+            for window in ws.windows {
+                if let v = findLiveStreamView(window) { return v }
+            }
+        }
+        return nil
+    }
+
+    private func withView(_ reactTag: NSNumber, _ block: @escaping (RNLiveStreamViewImpl) -> Void) {
+        let run = { [weak self] in
+            guard let self = self else { return }
+            if let bridge = self.bridge {
+                bridge.uiManager.addUIBlock { (_: RCTUIManager?, viewRegistry: [NSNumber: UIView]?) in
+                    let view = self.findLiveStreamView(viewRegistry?[reactTag]) ?? self.findInWindows()
+                    if let view = view { block(view) }
+                }
+            } else if let view = self.findInWindows() {
+                block(view)
+            }
+        }
+        if Thread.isMainThread { run() } else { DispatchQueue.main.async { run() } }
+    }
